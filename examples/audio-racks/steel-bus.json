{
  "format": "ink-studio/audio-rack",
  "version": 1,
  "id": "steel-bus",
  "revision": 1,
  "title": "Steel Bus",
  "description": "Preserve the drum attack while a compressed, colored branch fills in under it.",
  "inputs": {"main": "input"},
  "output": "bus",
  "strips": {
    "input": {"inserts": ["shape"], "fader": 0.84, "sends": {"parallel": {"tap": "pre", "level": 0.34}}},
    "parallel": {"inserts": ["weight", "iron", "cut"], "fader": 0.8},
    "bus": {}
  },
  "processors": {
    "shape": {"type": "transient", "attackDb": 3, "sustainDb": -1, "fast": 0.0028, "slow": 0.046, "wet": 0.85},
    "weight": {"type": "compressor", "thresholdDb": -31, "ratio": 7, "attack": 0.004, "release": 0.091, "lookahead": 0.009},
    "iron": {"type": "saturation", "driveDb": 14, "bias": 0.2, "toneHz": 4900, "outputDb": -5, "wet": 0.88},
    "cut": {"type": "eq", "bands": [{"mode": "highpass", "hz": 82}, {"mode": "peak", "hz": 1700, "q": 1.3, "gainDb": 1.5}]}
  },
  "taps": {"attack": {"strip": "input"}, "body": {"strip": "parallel"}},
  "macros": {
    "attack": {"label": "Attack", "default": 0.47, "targets": [{"path": ["processors", "shape", "attackDb"], "range": [-2, 10]}]},
    "weight": {"label": "Parallel weight", "default": 0.52, "targets": [
      {"path": ["strips", "input", "sends", "parallel", "level"], "range": [0.04, 0.66]},
      {"path": ["processors", "iron", "driveDb"], "range": [7, 20]}
    ]}
  }
}
