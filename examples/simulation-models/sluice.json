{
  "format": "ink-studio/simulation-model",
  "version": 1,
  "id": "sluice",
  "revision": 1,
  "seed": 27,
  "numerics": { "dt": 0.05 },
  "domain": {
    "grid": { "width": 8, "height": 2, "cell": 0.25, "origin": [0, 0] },
    "downstream": [1.125, 0.125]
  },
  "parameters": { "friction": 0.16, "releaseOpening": 0.85 },
  "initial": {
    "water": [{ "bounds": { "min": [0, 0], "max": [1, 0.5] }, "value": 0.22 }]
  },
  "boundaries": {
    "gates": {
      "sluice": { "axis": 0, "bounds": { "min": [0.99, 0], "max": [1.01, 0.5] }, "opening": 0 }
    }
  },
  "operators": {
    "basin": {
      "kind": "water",
      "revision": 1,
      "schedule": { "substeps": 2 },
      "config": {
        "width": { "$model": "/domain/grid/width" },
        "height": { "$model": "/domain/grid/height" },
        "cell": { "$model": "/domain/grid/cell" },
        "origin": { "$model": "/domain/grid/origin" },
        "friction": { "$model": "/parameters/friction" },
        "initial": { "$model": "/initial/water" },
        "gates": { "$model": "/boundaries/gates" },
        "sensors": { "outlet": { "$model": "/domain/downstream" } }
      }
    }
  },
  "inputs": { "gateOpening": "basin/gate.sluice" },
  "commands": [
    { "tick": 5, "input": "gateOpening", "value": { "$model": "/parameters/releaseOpening" } }
  ],
  "outputs": {
    "waterVolume": "basin/volume",
    "outletDepth": "basin/depth.outlet",
    "gateOpening": "basin/gate.sluice"
  },
  "probes": {
    "waterBudget": { "field": "basin/mass" },
    "outletFlow": { "field": "basin/flow", "at": [1.125, 0, 0.125] }
  }
}
